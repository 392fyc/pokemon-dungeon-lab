{
  "name": "dungeon-trial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "test": "node --experimental-strip-types --test tests/core/*.test.mjs",
    "test:acceptance": "node --experimental-strip-types --test tests/acceptance/*.test.mjs",
    "test:browser": "node tests/browser/windows.mjs && node tests/browser/web-ea.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
